library(sampling)
library(data.table)
library(stratification)
library(factoextra)
library(NbClust)
library(haven)
options(scipen=999)
# Source author-written functions
source("dfstrata.R")
source("elbow_plot.R")
################################################################################
## Part 1: Load Datasets
################################################################################
##### Dataset 1: ECD Census 2021 ######
load("ecd_census.RData")
df <- zap_label(zap_labels(df[order(df$fees_amount),]))
ecd <- as.data.frame(df[, c("fees_amount")])
names(ecd) <- "y"
ecd <- as.data.frame(ecd[ecd$y!=0,])
names(ecd) <- "y"
ecd_n <- 3711 ## 10% sample size, rounded up
set.seed(1234)
elbow_plot(ecd, 10)
#### Dataset 2: GHS 2024 ####
load("ghs_2024.RData")
df <- zap_label(zap_labels(df[order(df$totmhinc),]))
ghs <- as.data.frame(df[, c("totmhinc")])
names(ghs) <- "y"
ghs_n <- 2051
set.seed(1234)
elbow_plot(ghs, 8)
#### Dataset 3: GHS 2023 ####
load("ghs_2023.RData")
df <- zap_label(zap_labels(df[order(df$totmhinc),]))
ghs23 <- as.data.frame(df[, c("totmhinc")])
names(ghs23) <- "y"
ghs23_n <- 2055
set.seed(1234)
elbow_plot(ghs23, 8)
#### Dataset 4: TB5 ####
load("tb5.RData")
df <- zap_label(zap_labels(df[df$age<=59,]))
df <- df[order(df$total_elom),]
tb5<- as.data.frame(df[, c("total_elom")])
names(tb5) <- "y"
tb5_n <- 523
set.seed(1234)
elbow_plot(tb5, 10)
